---
import { render } from 'astro:content';
import { BaseLayout } from '@app/layouts';
import { pageTitle } from '@app/seo';
import { getPublishedPosts, postMarkdownPath, PostHeader, toPostSummary, type Post } from '@entities/post';
import { mdxComponents } from '@shared/ui';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const summary = toPostSummary(post);
const { Content } = await render(post);
---

<BaseLayout
  seo={{
    title: pageTitle(summary.title),
    description: summary.description,
    path: summary.href,
    markdownPath: postMarkdownPath(post.id),
    article: { ...summary, path: summary.href },
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: summary.title, path: summary.href },
    ],
  }}
>
  <article class="prose">
    <PostHeader post={summary} />
    <Content components={mdxComponents} />
  </article>
</BaseLayout>
